{
  "manifest_version": 3,
  "name": "Tab Context Grouper",
  "version": "0.1.0",
  "description": "Regroupe automatiquement vos onglets par contexte grâce à Gemini.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "notifications"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.run.app/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tab Context Grouper",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "group-now": {
      "suggested_key": { "default": "Alt+G" },
      "description": "Regrouper les onglets maintenant"
    }
  }
}
