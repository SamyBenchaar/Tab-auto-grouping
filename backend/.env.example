# Copy to backend/.env for local development (`npm run dev` loads it automatically).

# --- Option A: Vertex AI (same as production) -------------------------------------------
# Prerequisite: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
# eu = EU multi-region endpoint (GDPR). Other values: us, global.
GOOGLE_CLOUD_LOCATION=eu

# --- Option B: AI Studio key (quick local tests, no GCP project) -------------------------
# Remove GOOGLE_GENAI_USE_VERTEXAI above and set:
# GEMINI_API_KEY=your-ai-studio-key

# --- Model ---------------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
# LOW by default for Gemini 3.x (3.8 Flash does not accept MINIMAL). DEFAULT = model default.
# GEMINI_THINKING_LEVEL=LOW
# GEMINI_TIMEOUT_MS=8000
# Gemini 3.x: Google recommends keeping the default temperature. Uncomment only to experiment.
# GEMINI_TEMPERATURE=1.0

# --- Security ------------------------------------------------------------------------------
# Owner token expected in the "X-Extension-Token" header (or "Authorization: Bearer" locally): full access,
# no daily limit. Empty and no Google sign-in = auth disabled (local only; on Cloud Run the API refuses every request).
EXTENSION_TOKEN=change-me
# Google sign-in: OAuth client ID(s) of type "Chrome extension" (comma-separated). Empty = sign-in disabled.
# GOOGLE_OAUTH_CLIENT_IDS=123456789012-xxxxxxxx.apps.googleusercontent.com
# Allowed browser origins (comma-separated). Empty = any chrome-extension:// origin.
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
# RATE_LIMIT_PER_MINUTE=30

# --- Daily limits (Google-signed-in users only; 0 = no limit) -----------------------------
# DAILY_LIMIT_PER_USER=50
# GLOBAL_DAILY_LIMIT=300
# Counters: "memory" locally (default), "firestore" on Cloud Run (default there; needs GOOGLE_CLOUD_PROJECT).
# QUOTA_STORE=memory

# --- Privacy page (GET /privacy) -----------------------------------------------------------
# Contact shown on the page (e-mail or https URL). Empty = "see the Chrome Web Store listing".
# PRIVACY_CONTACT=
